<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="theme-color" content="#071f3d">
	<title>Project Registration Portal | Polytechnic College</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
	<style>
		:root {
			--navy: #071f3d;
			--navy-deep: #04152a;
			--blue: #0d4f91;
			--red: #d52f2f;
			--yellow: #ffd51f;
			--cream: #fffaf0;
			--muted: #718096;
			--line: #dce4ec;
			--white: #ffffff;
			--shadow: 0 24px 70px rgba(4, 21, 42, .18);
		}

		* { box-sizing: border-box; }
		body {
			margin: 0;
			min-height: 100vh;
			color: var(--navy);
			background: var(--cream);
			font-family: 'DM Sans', sans-serif;
			-webkit-font-smoothing: antialiased;
		}

		.portal {
			min-height: 100vh;
			display: grid;
			grid-template-columns: minmax(320px, .9fr) minmax(440px, 1.1fr);
			overflow: hidden;
		}

		.brand-panel {
			position: relative;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			padding: 42px clamp(28px, 5vw, 76px);
			color: var(--white);
			background:
				linear-gradient(145deg, rgba(7, 31, 61, .98), rgba(11, 70, 128, .93)),
				var(--navy);
			isolation: isolate;
		}

		.brand-panel::before,
		.brand-panel::after {
			content: '';
			position: absolute;
			z-index: -1;
			border-radius: 50%;
			pointer-events: none;
		}
		.brand-panel::before {
			width: 460px;
			height: 460px;
			top: -180px;
			right: -170px;
			border: 64px solid rgba(255, 213, 31, .12);
		}
		.brand-panel::after {
			width: 340px;
			height: 340px;
			bottom: -200px;
			left: -160px;
			background: rgba(213, 47, 47, .15);
		}

		.institution {
			display: flex;
			align-items: center;
			gap: 14px;
			font-family: 'Space Grotesk', sans-serif;
			font-size: .83rem;
			font-weight: 700;
			letter-spacing: .06em;
			line-height: 1.25;
			text-transform: uppercase;
		}
		.institution-mark {
			width: 42px;
			height: 42px;
			display: grid;
			place-items: center;
			color: var(--navy);
			background: var(--yellow);
			border-radius: 50%;
			font-family: 'Space Grotesk', sans-serif;
			font-size: 1.05rem;
			font-weight: 700;
		}

		.brand-content { max-width: 540px; margin: auto 0; padding: 42px 0; }
		.seal-wrap {
			position: relative;
			width: 154px;
			height: 154px;
			display: grid;
			place-items: center;
			margin-bottom: 30px;
			border: 1px solid rgba(255, 213, 31, .55);
			border-radius: 50%;
			background: rgba(255, 255, 255, .08);
			box-shadow: 0 18px 40px rgba(0, 0, 0, .18);
		}
		.seal-wrap::after {
			content: '';
			position: absolute;
			inset: 8px;
			border: 1px dashed rgba(255, 213, 31, .62);
			border-radius: 50%;
		}
		.seal {
			z-index: 1;
			width: 124px;
			height: 124px;
			object-fit: contain;
		}
		.seal-fallback {
			z-index: 1;
			display: none;
			place-items: center;
			width: 112px;
			height: 112px;
			border: 5px solid var(--yellow);
			border-radius: 50%;
			color: var(--yellow);
			font-family: 'Space Grotesk', sans-serif;
			font-size: 1.35rem;
			font-weight: 700;
			text-align: center;
		}
		.eyebrow {
			margin: 0 0 13px;
			color: var(--yellow);
			font-size: .75rem;
			font-weight: 700;
			letter-spacing: .17em;
			text-transform: uppercase;
		}
		h1, h2 { font-family: 'Space Grotesk', sans-serif; }
		h1 {
			max-width: 520px;
			margin: 0;
			font-size: clamp(2.15rem, 4.5vw, 4rem);
			letter-spacing: -.055em;
			line-height: .98;
		}
		.brand-copy {
			max-width: 450px;
			margin: 22px 0 0;
			color: rgba(255,255,255,.72);
			font-size: 1rem;
			line-height: 1.7;
		}
		.panel-footer {
			display: flex;
			justify-content: space-between;
			gap: 16px;
			color: rgba(255,255,255,.53);
			font-size: .76rem;
		}

		.form-panel {
			display: grid;
			place-items: center;
			padding: 42px clamp(24px, 6vw, 100px);
			background: #fbfaf7;
		}
		.login-card { width: min(100%, 430px); }
		.card-kicker {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			margin-bottom: 18px;
			color: var(--blue);
			font-size: .76rem;
			font-weight: 700;
			letter-spacing: .12em;
			text-transform: uppercase;
		}
		.card-kicker::before {
			content: '';
			width: 24px;
			height: 3px;
			background: var(--red);
			border-radius: 99px;
		}
		h2 {
			margin: 0;
			font-size: clamp(2rem, 3vw, 2.65rem);
			letter-spacing: -.05em;
			line-height: 1;
		}
		.form-intro { margin: 13px 0 32px; color: var(--muted); line-height: 1.6; }
		.field { margin-bottom: 19px; }
		label {
			display: block;
			margin-bottom: 8px;
			color: var(--navy);
			font-size: .83rem;
			font-weight: 700;
		}
		.input-wrap { position: relative; }
		input {
			width: 100%;
			height: 52px;
			padding: 0 15px;
			border: 1px solid var(--line);
			border-radius: 9px;
			outline: none;
			color: var(--navy);
			background: var(--white);
			font: inherit;
			transition: border .2s ease, box-shadow .2s ease;
		}
		input::placeholder { color: #a4afbb; }
		input:focus { border-color: var(--blue); box-shadow: 0 0 0 4px rgba(13, 79, 145, .12); }
		.password-input { padding-right: 52px; }
		.password-toggle {
			position: absolute;
			top: 50%;
			right: 8px;
			width: 36px;
			height: 36px;
			border: 0;
			border-radius: 7px;
			color: var(--muted);
			background: transparent;
			cursor: pointer;
			transform: translateY(-50%);
		}
		.password-toggle:hover { color: var(--blue); background: #edf3f8; }
		.form-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 3px 0 24px; }
		.remember { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: .8rem; font-weight: 500; }
		.remember input { width: 16px; height: 16px; accent-color: var(--blue); }
		.forgot { color: var(--blue); font-size: .8rem; font-weight: 700; text-decoration: none; }
		.forgot:hover { color: var(--red); text-decoration: underline; }
		.submit {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			width: 100%;
			height: 54px;
			border: 0;
			border-radius: 9px;
			color: var(--navy);
			background: var(--yellow);
			box-shadow: 0 8px 18px rgba(196, 157, 17, .22);
			cursor: pointer;
			font: 700 .92rem 'DM Sans', sans-serif;
			transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
		}
		.submit:hover { background: #ffdf43; box-shadow: 0 12px 24px rgba(196, 157, 17, .28); transform: translateY(-2px); }
		.submit:active { transform: translateY(0); }
		.submit svg { transition: transform .2s ease; }
		.submit:hover svg { transform: translateX(4px); }
		.status { min-height: 22px; margin: 13px 0 0; color: var(--red); font-size: .82rem; text-align: center; }
		.support { margin-top: 42px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: .78rem; text-align: center; }
		.support a { color: var(--blue); font-weight: 700; text-decoration: none; }

		@media (max-width: 800px) {
			.portal { grid-template-columns: 1fr; }
			.brand-panel { min-height: 430px; padding: 28px 24px; }
			.brand-content { margin: 34px 0 0; padding: 0 0 24px; }
			.seal-wrap { width: 100px; height: 100px; margin-bottom: 20px; }
			.seal { width: 80px; height: 80px; }
			.seal-fallback { width: 74px; height: 74px; font-size: .9rem; }
			h1 { font-size: clamp(2.1rem, 9vw, 3.4rem); }
			.panel-footer { display: none; }
			.form-panel { padding: 48px 24px 58px; }
		}
		@media (prefers-reduced-motion: reduce) {
			*, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
		}
	</style>
</head>
<body>
	<main class="portal">
		<section class="brand-panel" aria-label="Institution information">
			<div class="institution"><span class="institution-mark">PC</span><span>Polytechnic<br>College</span></div>
			<div class="brand-content">
				<div class="seal-wrap">
					<img class="seal" src="school-seal.png" alt="Polytechnic College seal" onerror="this.style.display='none'; document.querySelector('.seal-fallback').style.display='grid';">
					<div class="seal-fallback" aria-hidden="true">PC<br><small>1947</small></div>
				</div>
				<p class="eyebrow">Project Registration Portal</p>
				<h1>Build the work that moves your campus forward.</h1>
				<p class="brand-copy">A single place to register, monitor, and manage student and faculty projects from idea to completion.</p>
			</div>
			<div class="panel-footer"><span>Established 1947</span><span>Excellence · Service · Integrity</span></div>
		</section>

		<section class="form-panel" aria-label="Login form">
			<div class="login-card">
				<span class="card-kicker">Welcome back</span>
				<h2>Sign in to continue</h2>
				<p class="form-intro">Use your institutional account to access the project registration portal.</p>
				<form id="loginForm" novalidate>
					<div class="field">
						<label for="email">Institutional email</label>
						<input id="email" name="email" type="email" autocomplete="username" placeholder="you@polytechnic.edu" required>
					</div>
					<div class="field">
						<label for="password">Password</label>
						<div class="input-wrap">
							<input class="password-input" id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required>
							<button class="password-toggle" id="passwordToggle" type="button" aria-label="Show password" title="Show password">◉</button>
						</div>
					</div>
					<div class="form-row">
						<label class="remember"><input type="checkbox" name="remember"> Remember me</label>
						<a class="forgot" href="#forgot">Forgot password?</a>
					</div>
					<button class="submit" type="submit">Sign in <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></button>
					<p class="status" id="status" role="status" aria-live="polite"></p>
				</form>
				<p class="support">Need help accessing your account? <a href="mailto:it-support@polytechnic.edu">Contact IT support</a></p>
			</div>
		</section>
	</main>

	<script>
		const form = document.getElementById('loginForm');
		const email = document.getElementById('email');
		const password = document.getElementById('password');
		const passwordToggle = document.getElementById('passwordToggle');
		const status = document.getElementById('status');

		passwordToggle.addEventListener('click', () => {
			const isPassword = password.type === 'password';
			password.type = isPassword ? 'text' : 'password';
			passwordToggle.textContent = isPassword ? '◌' : '◉';
			passwordToggle.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
			passwordToggle.setAttribute('title', isPassword ? 'Hide password' : 'Show password');
		});

		form.addEventListener('submit', event => {
			event.preventDefault();
			status.textContent = '';
			if (!email.value.trim() || !password.value) {
				status.textContent = 'Please enter your email and password.';
				(!email.value.trim() ? email : password).focus();
				return;
			}
			if (!email.validity.valid) {
				status.textContent = 'Please enter a valid institutional email.';
				email.focus();
				return;
			}
			status.style.color = '#0d4f91';
			status.textContent = 'Sign-in is ready to connect to your account service.';
		});
	</script>
</body>
</html>